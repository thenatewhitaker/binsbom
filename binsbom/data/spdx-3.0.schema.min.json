{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SPDX 3.0 (minimal)",
  "type": "object",
  "required": [
    "spdxVersion",
    "SPDXID",
    "creationInfo",
    "packages",
    "relationships"
  ],
  "properties": {
    "spdxVersion": {
      "type": "string"
    },
    "SPDXID": {
      "type": "string"
    },
    "creationInfo": {
      "type": "object"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "SPDXID",
          "name"
        ],
        "properties": {
          "SPDXID": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "versionInfo": {
            "type": [
              "string",
              "null"
            ]
          },
          "externalRefs": {
            "type": "array"
          },
          "checksums": {
            "type": "array"
          }
        }
      }
    },
    "files": {
      "type": "array"
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "spdxElementId",
          "relationshipType",
          "relatedSpdxElement"
        ],
        "properties": {
          "spdxElementId": {
            "type": "string"
          },
          "relationshipType": {
            "type": "string"
          },
          "relatedSpdxElement": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}